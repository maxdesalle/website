{{- /* Section-scoped podcast feed: iTunes + Podcasting 2.0 + MRSS. Applies only to /podcast/index.xml. */ -}}
{{- $author := .Params.author | default site.Params.author -}}
{{- $ownerEmail := .Params.owner_email | default site.Params.email -}}
{{- $summary := .Params.summary | default .Description | default site.Params.description -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" xmlns:podcast="https://podcastindex.org/namespace/1.0" xmlns:media="http://search.yahoo.com/mrss/" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Params.feed_title | default .Title }}</title>
    <link>{{ site.BaseURL }}</link>
    <language>{{ .Params.language | default site.LanguageCode | default "en-us" }}</language>
    <description>{{ $summary | html }}</description>
    <itunes:summary>{{ $summary | html }}</itunes:summary>
    <itunes:author>{{ $author }}</itunes:author>
    <itunes:type>{{ .Params.itunes_type | default "episodic" }}</itunes:type>
    <itunes:explicit>{{ if .Params.explicit }}true{{ else }}false{{ end }}</itunes:explicit>
    {{- with .Params.image }}
    <itunes:image href="{{ . }}" />{{ end }}
    {{- with $ownerEmail }}
    <itunes:owner><itunes:name>{{ $author }}</itunes:name><itunes:email>{{ . }}</itunes:email></itunes:owner>
    <managingEditor>{{ . }}{{ with $author }} ({{ . }}){{ end }}</managingEditor>
    <podcast:locked owner="{{ . }}">yes</podcast:locked>{{ end }}
    {{- range .Params.itunes_categories }}{{ $c := split . "/" }}
    <itunes:category text="{{ index $c 0 | html }}">{{ if gt (len $c) 1 }}<itunes:category text="{{ index $c 1 | html }}" />{{ end }}</itunes:category>{{ end }}
    {{- with .Params.podcast_guid }}
    <podcast:guid>{{ . }}</podcast:guid>{{ end }}
    <podcast:person role="host"{{ with .Params.author_x }} href="https://x.com/{{ . }}"{{ end }}>{{ $author }}</podcast:person>
    <generator>Hugo -- gohugo.io</generator>
    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}{{ end }}
    {{- range .RegularPages }}
    {{- $p := . }}{{ $guests := .Params.guests -}}
    {{- /* Show notes: the hook, who to follow, where to watch, then the chapter list with its
           on-page seek links unwrapped to plain timestamps, which apps turn into chapters. */ -}}
    {{- $notes := printf "<p>%s</p>" .Description -}}
    {{- with $guests }}{{ $links := slice }}{{ range . }}{{ $links = $links | append (printf "<a href=\"https://x.com/%s\">%s</a>" .x .name) }}{{ end }}
    {{- $notes = printf "%s<p>Guest%s: %s</p>" $notes (cond (gt (len .) 1) "s" "") (delimit $links ", " " and ") }}{{ end -}}
    {{- $notes = printf "%s<p>%s<a href=\"%s\">Transcript</a> · <a href=\"https://x.com/%s\">Follow Maxime on X</a></p>" $notes (cond (isset .Params "youtube_url") (printf "<a href=\"%s\">Watch on YouTube</a> · " .Params.youtube_url) "") .Permalink $.Params.author_x -}}
    {{- $notes = printf "%s%s" $notes (replaceRE `<a href="#t=[^"]*">([^<]*)</a>` "$1" .Content) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="false">{{ .Params.guid | default .File.UniqueID }}</guid>
      <description>{{ $notes | html }}</description>
      <itunes:summary>{{ (.Description | default .Summary) | html }}</itunes:summary>
      <itunes:episodeType>full</itunes:episodeType>
      {{- with .Params.duration }}
      <itunes:duration>{{ . }}</itunes:duration>{{ end }}
      {{- with .Params.episode }}
      <itunes:episode>{{ . }}</itunes:episode>{{ end }}
      {{- with .Params.season }}
      <itunes:season>{{ . }}</itunes:season>{{ end }}
      <itunes:explicit>{{ if .Params.explicit }}true{{ else }}false{{ end }}</itunes:explicit>
      {{- with .Params.audio_url }}
      <enclosure url="{{ . }}" length="{{ $p.Params.audio_bytes | default 0 }}" type="audio/mpeg" />{{ end }}
      {{- with .OutputFormats.Get "chapters" }}
      <podcast:chapters url="{{ .Permalink }}" type="application/json+chapters" />{{ end }}
      {{- with .Params.transcript_file }}{{ with resources.Get (replace . ".md" ".vtt") }}
      <podcast:transcript url="{{ .Permalink }}" type="text/vtt" language="en" />{{ end }}{{ end }}
      {{- range $guests }}
      <podcast:person role="guest" href="https://x.com/{{ .x }}">{{ .name }}</podcast:person>{{ end }}
      {{- with .Params.video_url }}
      <media:content url="{{ . }}" fileSize="{{ $p.Params.video_bytes | default 0 }}" type="video/mp4" medium="video" />{{ end }}
    </item>{{ end }}
  </channel>
</rss>
